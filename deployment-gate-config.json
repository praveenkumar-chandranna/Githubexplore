{
  "branch_to_env": {
    "DEV":  "DEV",
    "QA":   "QA",
    "UAT":  "UAT",
    "main": "PRODUCTION"
  },
  "promotion_chain": {
    "QA":         "DEV",
    "UAT":        "QA",
    "PRODUCTION": "UAT"
  },
  "hotfix": {
    "branch_pattern": "hotfix/*",
    "allowed_environments": ["UAT", "PRODUCTION"],
    "pr_target_branch": "main"
  },
  "retrieve": {
    "branch_pattern": "retrieve/*",
    "gate_bypass": true
  },
  "gate_enabled": true
}
